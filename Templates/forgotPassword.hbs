<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset your Wispa password</title>
</head>
<body style="margin:0;padding:0;background-color:#0f1117;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">

  <!-- Outer wrapper -->
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#0f1117;min-height:100vh;">
    <tr>
      <td align="center" style="padding:40px 16px;">

        <!-- Card -->
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;">

          <!-- Header glow bar -->
          <tr>
            <td style="background:linear-gradient(90deg,#1a5c3e 0%,#2d9268 50%,#1a5c3e 100%);height:4px;border-radius:4px 4px 0 0;"></td>
          </tr>

          <!-- Card body -->
          <tr>
            <td style="background-color:#1c1f2e;border-radius:0 0 20px 20px;padding:40px 40px 36px;border:1px solid rgba(255,255,255,0.08);border-top:none;">

              <!-- Lock icon -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding-bottom:28px;">
                    <div style="display:inline-block;background:linear-gradient(135deg,#1a5c3e,#2d9268);border-radius:20px;width:64px;height:64px;line-height:64px;text-align:center;font-size:32px;">
                      🔐
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Heading -->
              <h1 style="margin:0 0 8px;font-size:22px;font-weight:700;color:#ffffff;text-align:center;letter-spacing:-0.3px;">
                Reset your password
              </h1>
              <p style="margin:0 0 32px;font-size:14px;color:rgba(255,255,255,0.45);text-align:center;line-height:1.6;">
                Hey <strong style="color:rgba(255,255,255,0.75);">{{name}}</strong>, no worries — it happens to the best of us.
                Use the code below to get back in.
              </p>

              <!-- Code box -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding-bottom:28px;">
                    <div style="display:inline-block;background:rgba(45,146,104,0.12);border:1px solid rgba(45,146,104,0.30);border-radius:16px;padding:20px 48px;">
                      <p style="margin:0 0 6px;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(74,174,135,0.75);">
                        Your reset code
                      </p>
                      <p style="margin:0;font-size:36px;font-weight:800;color:#4aae87;letter-spacing:6px;font-family:'Courier New',Courier,monospace;">
                        {{code}}
                      </p>
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Instructions -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td style="background-color:rgba(255,255,255,0.03);border-radius:10px;padding:16px 20px;margin-bottom:28px;">
                    <p style="margin:0;font-size:13px;color:rgba(255,255,255,0.40);line-height:1.8;">
                      ⏱&nbsp; This code expires in <strong style="color:rgba(255,255,255,0.60);">10 minutes</strong>.<br/>
                      🔒&nbsp; Enter it on the reset page to choose a new password.<br/>
                      🚫&nbsp; Didn't request this? You can safely ignore this email.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Divider -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td style="padding:24px 0 0;">
                    <div style="height:1px;background:rgba(255,255,255,0.07);"></div>
                  </td>
                </tr>
              </table>

              <!-- Security note -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td style="padding-top:24px;">
                    <p style="margin:0;font-size:13px;color:rgba(255,255,255,0.30);line-height:1.7;text-align:center;">
                      Never share this code with anyone — including us.<br/>
                      Wispa staff will <em>never</em> ask you for it.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding-top:28px;padding-bottom:8px;">
              <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:rgba(255,255,255,0.35);letter-spacing:0.5px;">
                WISPA
              </p>
              <p style="margin:0;font-size:12px;color:rgba(255,255,255,0.20);">
                Say it anonymously. No traces. No regrets.
              </p>
            </td>
          </tr>

        </table>
        <!-- /Card -->

      </td>
    </tr>
  </table>

</body>
</html>
