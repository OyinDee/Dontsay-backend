<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{recipientUsername}} replied on Wispa</title>
</head>
<body style="margin:0;padding:32px;background-color:#0f1117;font-family:Arial,Helvetica,sans-serif;color:#ffffff;">
  <main style="max-width:560px;margin:0 auto;padding:32px;background-color:#1c1f2e;border-radius:16px;">
    <h1 style="font-size:22px;">{{recipientUsername}} replied to your anonymous message</h1>
    <p style="color:#b7bac7;">Your alias: <strong>{{alias}}</strong></p>
    <blockquote style="margin:24px 0;padding:16px;border-left:3px solid #2d9268;background:#151824;white-space:pre-wrap;">{{content}}</blockquote>
    <p><a href="{{appLink}}" style="color:#4aae87;">Visit Wispa</a></p>
  </main>
</body>
</html>
